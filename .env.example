# Copy to your host's environment settings (e.g. Render → Environment). Never commit real secrets.

# Site
BRAND_NAME=Hypecut
SITE_URL=https://your-domain.com
SUPPORT_EMAIL=support@your-domain.com
COMPANY_NAME=Hypecut
SECRET_KEY=            # long random string; generated automatically if empty
ADMIN_EMAILS=          # comma-separated emails that can open any project

# Storage
DATA_DIR=/data
JOB_TTL_HOURS=48
MIN_FREE_GB=5

# Paddle Billing (paddle.com). Use PADDLE_ENV=sandbox while testing.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=   # Developer tools → Authentication → client-side token
PADDLE_API_KEY=        # Developer tools → Authentication → API key (secret)
PADDLE_WEBHOOK_SECRET= # Developer tools → Notifications → your endpoint's secret key
PADDLE_PRICE_CREATOR=  # pri_... for the $19/month Creator price
PADDLE_PRICE_PRO=      # pri_... for the $49/month Pro price


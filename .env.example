# ===================== backend/ (API + worker) — repo-root .env in development
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server-only. Never in web/.
WEB_ORIGINS=http://localhost:3000          # CORS: the website's URL(s)
API_URL=http://localhost:8765              # the API's own public URL
JOB_TTL_HOURS=48
# Cloudflare R2 (required in production; local disk is used in development without these)
# S3_ENDPOINT: the bucket's "S3 API" URL from Cloudflare. The bucket name at the end is fine.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Paddle Billing (server side)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREATOR=
PADDLE_PRICE_PRO=

# ===================== web/.env.local — public values only (they ship to the browser)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_API_URL=http://localhost:8765
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# NEXT_PUBLIC_AUTH_PROVIDERS=google,twitch
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
# NEXT_PUBLIC_PADDLE_PRICE_CREATOR=pri_...
# NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_...
